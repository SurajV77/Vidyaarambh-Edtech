# ============================================================
# VIDYAARAMBH - BACKEND ENVIRONMENT CONFIGURATION (.env)
# ============================================================

# Application Port
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas)
# Replace with your connection string: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vidyaarambh?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string

# JSON Web Token Secret
# Generate a strong 32+ character random string
JWT_SECRET=your_long_random_secret

# Cloudinary Storage for PDF Files (Homework, Notes, Tests)
# Obtain from your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ------------------------------------------------------------
# INITIAL TEACHER/ADMIN SETUP (Used by `npm run seed:admin`)
# ------------------------------------------------------------
# These values are only read when running `npm run seed:admin`
ADMIN_NAME=Admin Teacher
ADMIN_EMAIL=admin@vidyaarambh.com
ADMIN_PASSWORD=your_secure_password
